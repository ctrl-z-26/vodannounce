# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# The port number your Express server will listen on locally
PORT=3000

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Your unique project API URL found in Project Settings > API
SUPABASE_URL=https://supabase.co

# The SERVICE_ROLE key for backend administrative access.
# WARNING: Bypasses Row Level Security (RLS). Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
