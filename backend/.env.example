# ==============================================================================
# SERVER CONFIGURATION
# ==============================================================================
# The port number your Express server will listen on locally
PORT=3000

# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Your unique project API URL found in Project Settings > API.
# Must be the bare base URL (e.g. https://<project-ref>.supabase.co)
# with NO path, query params, or trailing suffix like /rest/v1/ —
# the supabase-js client appends those API paths itself.
SUPABASE_URL=https://supabase.co

# The SERVICE_ROLE key for backend administrative access.
# WARNING: Bypasses Row Level Security (RLS). Never expose this key to the frontend.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ==============================================================================
# FIREBASE FCM CONFIGURATION
# ==============================================================================
# Paste the entire content of your firebase-adminsdk.json file as a single-line string.
# In your real .env file, wrap the whole string in single quotes: FCM_SERVICE_ACCOUNT_JSON='{...}'
FCM_SERVICE_ACCOUNT_JSON=your_entire_firebase_json_string_here
