# ==============================================================================
# SUPABASE CONFIGURATION
# ==============================================================================
# Your unique project API URL found in Project Settings > API.
# Must be the bare base URL (e.g. https://<project-ref>.supabase.co)
# with NO path, query params, or trailing suffix like /rest/v1/ —
# the supabase-js client appends those API paths itself.
VITE_SUPABASE_URL=https://supabase.co

# The publishable key for the mobile client, found in Project Settings > API.
# This is the safe client-side key used by supabase-js.
# WARNING: Never put the service_role key here — it bypasses Row Level
# Security (RLS) and must only live server-side.
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
